# Configuración de scripts/operacion/backup-db.sh y prueba-restauracion.sh.
# Copiar a ~/.config/lopest-backup.env (chmod 600). Todas las claves son
# opcionales: sin este archivo se usan los valores por defecto que se muestran.

# Destino local, fuera del repositorio (git clean o un checkout nunca lo tocan).
BACKUP_DIR=/home/deploy/backups/lopest
DB_CONTAINER=lopest_db

# Retención: copias diarias y semanales (la semanal se toma el día WEEKLY_DAY,
# 1 = lunes ... 7 = domingo, como enlace duro de la diaria: no ocupa disco extra).
KEEP_DAILY=14
KEEP_WEEKLY=8
WEEKLY_DAY=7

# Por debajo de este tamaño el volcado se considera vacío o roto y se rechaza.
MIN_DUMP_BYTES=50000

# Copia off-site con rclone (DESACTIVADA mientras esté vacío).
# Ejemplo Google Drive: OFFSITE_REMOTE=gdrive:Backups/lopest
# Ejemplo Backblaze B2: OFFSITE_REMOTE=b2:mi-bucket/lopest
# El remoto se configura una vez con:
#   docker run --rm -it -v ~/.config/rclone:/config/rclone rclone/rclone:1.68.2 config
OFFSITE_REMOTE=
RCLONE_IMAGE=rclone/rclone:1.68.2
RCLONE_CONFIG_DIR=/home/deploy/.config/rclone

# Latido externo estilo healthchecks.io (DESACTIVADO mientras esté vacío):
# se llama a la URL en cada éxito y a URL/fail en cada fallo; si el latido
# deja de llegar, el servicio avisa por correo aunque el servidor esté caído.
HEALTHCHECK_URL=
